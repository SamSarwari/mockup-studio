{
  "expo": {
    "name": "Mockup Studio",
    "slug": "MockupGenerator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mockupstudio",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070D1A"
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mockupgenerator.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Select screenshots and images from your photo library to display inside device frames and create mockups.",
        "NSPhotoLibraryAddUsageDescription": "Save your generated device mockups directly to your photo library."
      }
    },
    "android": {
      "package": "com.mockupgenerator.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#070D1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Select screenshots and images from your photo library to display inside device frames and create mockups.",
          "savePhotosPermission": "Save your generated device mockups directly to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select screenshots and images from your photo library to display inside device frames and create mockups.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "841ee9f8-a566-42a3-ab96-3be14556d87f"
      }
    },
    "owner": "samsarwaris-team"
  }
}
